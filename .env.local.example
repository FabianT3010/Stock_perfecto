# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase.
# (Supabase Dashboard -> Project Settings -> API)

# URL del proyecto (pública). Ej: https://abcdxyz.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (pública, segura para el navegador).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role (SECRETA, solo servidor). NUNCA la expongas en el cliente
# ni la subas al repo. Se usa en los route handlers para escribir en la BD.
SUPABASE_SERVICE_ROLE_KEY=
